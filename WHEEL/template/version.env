WHEEL_PACKAGE_BASE_URL="https://github.com/RIKEN-RCCS/OPEN-WHEEL/releases/download"
#WHEEL_SIFDIR=${HOME}/ondemand/SIF #for sandbox
WHEEL_SIFDIR=/home/apps/singularity/ondemand/
declare -A -p APP_VERSIONS &>/dev/null || declare -A APP_VERSIONS

# APP_VERSIONS["version"]="containerURL sifFilePath"
#latest release version
APP_VERSIONS["latest-2026"]="${WHEEL_PACKAGE_BASE_URL}/2026-1014-045115-release/wheel.sif ${WHEEL_SIFDIR}/wheel_2026-1014-045115-release.sif"
#Previous master branch of OPEN-WHEEL. It is currently disabled in the UI so that users cannot select it.   
APP_VERSIONS["2025"]="${WHEEL_PACKAGE_BASE_URL}/2026-0922-154018-maintenance/wheel.sif ${WHEEL_SIFDIR}/wheel_2026-0922-154018-maintenance.sif"
#The version was offered on FugakuOnDemand until summer 2026.
APP_VERSIONS["2023"]="${WHEEL_PACKAGE_BASE_URL}/2026-0922-154003-maintenance/wheel.sif ${WHEEL_SIFDIR}/wheel_2026-0922-154003-maintenance.sif"
